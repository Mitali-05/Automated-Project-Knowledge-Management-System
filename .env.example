# --- Local dev default (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pkm_dev
DB_USERNAME=pkm_user
DB_PASSWORD=pkm_local_pw

# --- AWS : once RDS instance exists ---
# DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=pkm
# DB_USERNAME=<rds-master-username>
# DB_PASSWORD=<rds-master-password>

JWT_SECRET=replace-with-a-real-random-32+-char-secret
JWT_EXPIRATION_MS=86400000
