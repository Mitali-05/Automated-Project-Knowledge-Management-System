# GitHub: fine-grained PAT scoped to specific repos only.
# Create at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# LLM: default provider is Gemini 2.5 Flash (OpenAI-compatible endpoint).
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini-2.5-flash
LLM_API_KEY=

# Optional tuning
MAX_INPUT_TOKENS_PER_BATCH=6000
MAX_SOURCE_FILES=12
MAX_FILE_BYTES=20000
