# PRISM backend - loaded automatically from the repository root.
# Local secrets: never commit this file. Use unquoted values (Spring properties format).
# REQUIRED: fill DB_PASSWORD and generate JWT_SECRET before starting the backend.

# Database - AWS RDS PostgreSQL (Sydney)
DB_HOST=prism-db.cpeagqqco1ma.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pkm_dev
DB_USERNAME=pkm_user
DB_PASSWORD=
# Explicit TLS for the PostgreSQL JDBC driver; loaded by Spring Boot.
SPRING_DATASOURCE_HIKARI_DATA_SOURCE_PROPERTIES_SSLMODE=require

# HTTP server and browser access
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication - JWT lifetime in milliseconds; 28800000 = 8 hours
JWT_SECRET=
JWT_EXPIRATION_MS=28800000
AUTH_RATE_LIMIT_PER_MINUTE=10

# GitHub App - configure once for PRISM, not once per end user
GITHUB_APP_ID=4836790
GITHUB_APP_SLUG=PRISM-Knowledge-Manager
GITHUB_APP_CLIENT_ID=Iv23liR3Bo300FRRGEWZ
GITHUB_APP_CLIENT_SECRET=
# Base64-encode the complete PEM private key into one line.
GITHUB_APP_PRIVATE_KEY_BASE64=

# Extraction bridge - must match extractor/.env; blank disables ingestion
INGEST_SERVICE_KEY=

# Hybrid assistant - explicit configuration; no model switching
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Keep false when running prism_bridge.py in its own terminal.
EXTRACTOR_AUTO_START=false
# Required only when EXTRACTOR_AUTO_START=true; use absolute paths.
EXTRACTOR_PYTHON_PATH=
EXTRACTOR_WORKING_DIR=

# Jira OAuth 2.0 - backend only; never expose these values in Vite.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:5173/app/jira/callback
# Base64 of 32 random bytes. Keep stable: changing it makes stored Jira tokens unreadable.
JIRA_TOKEN_ENCRYPTION_KEY=
GITHUB_REDIRECT_URI=http://localhost:5173/app/github/callback
