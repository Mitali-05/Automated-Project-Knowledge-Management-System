# Copy to `.env` (repo root) and fill in. `.env` is git-ignored - NEVER commit real values.
# The backend loads this file automatically when started from the repo root or from backend/.

# ---- Database (defaults match docker-compose.yml for local development) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pkm_dev
DB_USERNAME=pkm_user
DB_PASSWORD=pkm_local_pw
# For AWS RDS: set DB_HOST to the RDS endpoint and use a NEW database name (the schema is created by Flyway).

# ---- Security ----
# REQUIRED. At least 32 random characters. Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-value
JWT_EXPIRATION_MS=28800000
# Comma-separated list of browser origins allowed to call the API (only needed if the frontend is on another origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- GitHub App (optional until you connect private repositories) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The whole .pem file, base64 encoded:  base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
# Recommended: enables verification that a user really owns the installation they connect.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Extraction service integration (Python) ----
# Shared secret the extraction service sends in the X-Service-Key header. Leave empty to disable /api/ingest.
INGEST_SERVICE_KEY=

# ---- Demo ----
# true = project owners can load sample knowledge into an empty project (for demos). Keep false in production.
APP_DEMO_ENABLED=true
