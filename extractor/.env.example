# PRISM extractor / Streamlit / bridge - run commands from extractor/.
# Local secrets: never commit this file.
# REQUIRED: fill both LLM API keys; fill DB_PASSWORD for standalone vector storage.

# Report agent - provider identifier and model identifier are separate settings
LLM1_PROVIDER=gemini
LLM1_MODEL=gemini-3.5-flash-lite
LLM1_API_KEY=

# Verification agent - Gemini configuration; no Bedrock credentials required
LLM2_PROVIDER=gemini
LLM2_MODEL=gemini-3.5-flash-lite
LLM2_API_KEY=

# Extraction limits - token count, file count, and bytes per source file
MAX_INPUT_TOKENS_PER_BATCH=6000
MAX_SOURCE_FILES=12
MAX_FILE_BYTES=20000

# Backend ingestion bridge - URL has no trailing slash; poll interval in seconds
PRISM_API_URL=http://localhost:8081
PRISM_POLL_SECONDS=10
# Must equal the root .env value.
INGEST_SERVICE_KEY=

# GitHub App - standalone extractor authentication
# Current extractor locates a *.pem private-key file; this differs from the backend.
GITHUB_APP_ID=4836790
# GitHub App URL slug, not its display title; confirm in your GitHub App settings.
GITHUB_APP_NAME=PRISM-Knowledge-Manager
GITHUB_INSTALLATION_ID=166946530

# Standalone vector storage - the bridge itself sends results through the API
DB_HOST=prism-db.cpeagqqco1ma.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pkm_dev
# Existing Python code reads DB_USER, not DB_USERNAME.
DB_USER=pkm_user
DB_PASSWORD=
DB_SSLMODE=require

# Maximum duration per local diagram render; timeouts remain sync failures.
MERMAID_RENDER_TIMEOUT_SECONDS=180
