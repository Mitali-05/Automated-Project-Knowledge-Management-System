# PRISM frontend - Vite development configuration
# NEVER put API keys, passwords, JWT secrets, or service secrets here.
# VITE_ values are exposed to browser users.

# Empty means same-origin /api requests through the Vite proxy.
VITE_API_URL=
# Backend proxy target; used by the development server only.
DEV_API_TARGET=http://127.0.0.1:8080
